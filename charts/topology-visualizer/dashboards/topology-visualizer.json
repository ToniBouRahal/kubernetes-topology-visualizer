{
  "__comment": "ADR-011 D-11.3. Pipeline health, not topology. Every metric name here must exist in agent/cmd/agent/main.go or backend/app/api/metrics.py — verify-chart.sh T-11.3 checks. Counters reset on restart, so panels show rate() or increase(), never a raw total.",
  "title": "Topology Visualizer — pipeline health",
  "uid": "topology-visualizer-pipeline",
  "tags": ["topology-visualizer", "ebpf"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(topology_backend_stored_edge_buckets, namespace)",
        "query": {
          "query": "label_values(topology_backend_stored_edge_buckets, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Pipeline health, not topology.** The graph shows the connections that were observed; a rejected batch and an absence of traffic look identical there. These panels exist so they do not look identical here. Every count is a TCP connection establishment — one pooled connection carrying ten thousand requests is one. Counters reset on restart, so panels show rates and increases over the selected range, never raw totals."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Collection — agent, per node",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kernel samples lost",
      "description": "> 0 is data loss. The ring buffer overflowed and those connections never reached the graph. Increase over the selected range.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(topology_agent_kernel_samples_lost_total{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "lost",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unresolved ÷ observations",
      "description": "High relative to observations means the informer cannot map an address to a workload — usually pod churn, sometimes RBAC. Those observations are dropped, not drawn.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(topology_agent_endpoints_unresolved_total{namespace=\"$namespace\"}[$__range])) / sum(increase(topology_agent_observations_total{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "unresolved share",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "no observations",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Foreign-node events",
      "description": "Should read 0 on a real cluster. Non-zero means nodes share a kernel (kind), and without this filter every connection would be counted once per node.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(topology_agent_events_filtered_foreign_node_total{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "foreign node",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Batches dropped",
      "description": "The delivery queue overflowed: the backend was unreachable for longer than the queue could absorb. The edges in those batches are gone.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(topology_agent_batches_dropped_total{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "dropped",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active opens observed per second, by node",
      "description": "TCP active opens the BPF program submitted, before any filtering. One line per agent pod, which is one per node.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (pod) (rate(topology_agent_raw_events_received_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "connections / s"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Observation funnel per second, all nodes",
      "description": "What happens to an observation between the kernel and a batch. Everything below the top line was dropped for the reason named — and never reached the graph.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_observations_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "observations offered",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_endpoints_unresolved_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "dropped: unresolved endpoint",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_filtered_infrastructure_port_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "dropped: infrastructure port",
          "range": true
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_filtered_not_graphable_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "dropped: not graphable (host)",
          "range": true
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_events_filtered_foreign_node_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "dropped: foreign node",
          "range": true
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_kernel_samples_lost_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "lost: ring buffer full",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "observations / s"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "lost: ring buffer full" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Delivery — agent → backend",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Batch delivery per second, all nodes",
      "description": "A batch leaves memory only after the backend answers 2xx. Retries are expected during a backend restart; drops and permanent rejections are not.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_batches_sent_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "accepted by backend",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_batches_duplicate_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "already stored (retry)",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_batches_retried_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "retried",
          "range": true
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_batches_rejected_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "rejected permanently",
          "range": true
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_agent_batches_dropped_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "dropped (queue overflow)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "batches / s"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "dropped (queue overflow)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "rejected permanently" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Delivery queue depth, by node",
      "description": "Batches waiting to be sent. Persistently rising means delivery is slower than aggregation; the queue is bounded (agent.maxPendingBatches) and evicts the oldest batch when full.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topology_agent_delivery_queue_depth{namespace=\"$namespace\"}",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "batches"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Pending edges this interval, by node",
      "description": "Distinct edges accumulated since the last flush. Sawtooth is normal — it resets every flush interval.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topology_agent_pending_edges{namespace=\"$namespace\"}",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "edges"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Backend",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Ingest per second",
      "description": "Deduplicated batches are agent retries the backend had already stored — expected after a backend restart, and the reason a retry never double-counts.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_backend_batches_accepted_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "accepted",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_backend_batches_deduplicated_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "deduplicated (agent retries)",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_backend_batches_rejected_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "rejected (malformed)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "batches / s"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "rejected (malformed)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Graph query latency, mean",
      "description": "Mean over the rate window. The backend exports a running sum and count rather than a histogram, by design, so a percentile is not derivable here. The Phase 5 target was 500 ms p95; measured 62 ms at 500 nodes / 2,000 edges.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_backend_graph_query_seconds_total{namespace=\"$namespace\"}[$__rate_interval])) / sum(rate(topology_backend_graph_queries_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "mean graph query",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Queries per second",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_backend_graph_queries_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "graph",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(topology_backend_diff_queries_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "diff (compare mode)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "queries / s"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Stored edge buckets",
      "description": "One row per distinct edge per minute, retentionHours deep. Storage grows with distinct edges, not with traffic volume — a busy edge and a quiet one occupy the same row.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(topology_backend_stored_edge_buckets{namespace=\"$namespace\"})",
          "legendFormat": "buckets",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Buckets removed by retention",
      "description": "Rows purged by the hourly retention job over the selected range. Zero is normal until the deployment is older than retentionHours.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 34 },
      "targets": [
        {
          "refId": "A",
