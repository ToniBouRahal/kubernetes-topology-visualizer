    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/api/generated/schema.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.11.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^6",
    "jsdom": "^27",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
