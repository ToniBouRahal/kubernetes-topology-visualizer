          },
          "baseline_connection_count": {
            "title": "Baseline Connection Count",
            "type": "integer"
          },
          "bytes_percent_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bytes Percent Delta"
          },
          "classification": {
            "enum": [
              "NEW",
              "REMOVED",
              "CHANGED",
              "UNCHANGED"
            ],
            "title": "Classification",
            "type": "string"
          },
          "connection_delta": {
            "title": "Connection Delta",
            "type": "integer"
          },
          "connection_percent_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connection Percent Delta"
          },
          "current_bytes_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Bytes Total"
          },
          "current_connection_count": {
            "title": "Current Connection Count",
            "type": "integer"
          },
          "destination_port": {
            "title": "Destination Port",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "protocol": {
            "const": "TCP",
            "title": "Protocol",
            "type": "string"
          },
          "reason": {
            "description": "Human-readable justification for the classification, including the comparison performed and the threshold applied.",
            "title": "Reason",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "target_id": {
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_id",
          "target_id",
          "protocol",
          "destination_port",
          "classification",
          "baseline_connection_count",
          "current_connection_count",
          "connection_delta",
          "reason"
        ],
        "title": "DiffEdge",
        "type": "object"
      },
      "DiffResponse": {
