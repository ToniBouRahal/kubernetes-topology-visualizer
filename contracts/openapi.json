  "info": {
    "description": "Runtime service topology for Kubernetes, collected with eBPF.\n\nThis document is the contract between the backend, the Go node agent, and the React frontend.\nIt is generated from the FastAPI application and committed as `contracts/openapi.json`; CI fails\nif the committed copy drifts. Never hand-edit it.\n\nIdentity, edge keys, status codes, and determinism rules are specified in `contracts/ids.md`.",
    "title": "Kubernetes Runtime Topology Visualizer",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/diff": {
      "get": {
        "description": "Deterministic comparison of two periods.\n\nA period with no observation contributes zero, not null. Percentage delta is undefined when\nthe baseline is zero, and the reason field says so.",
        "operationId": "get_diff_api_v1_diff_get",
        "parameters": [
          {
            "in": "query",
            "name": "baseline_from",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Baseline From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "baseline_to",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Baseline To",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "current_from",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Current From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "current_to",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Current To",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "namespace",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Namespace"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "Service",
                    "Deployment",
                    "StatefulSet",
                    "DaemonSet",
                    "Job",
                    "Pod"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Query"
            }
          },
          {
            "in": "query",
            "name": "include_external",
            "required": false,
