# ── Pre-existing user content at this path (preserved on disk, not part of this project) ──
# An earlier, unrelated POC plus a stray empty file created before this repository existed.
# ADR-001 §12 instruction 10: preserve user-owned files. Delete manually if unwanted.
/poc-kind-topology/
/l

# ── Go ──
/agent/agent
*.test
*.out
# bpf2go output IS committed, deliberately.
# Generation needs clang + libbpf headers, which only the builder container has. Committing the
# bindings and the object keeps `go build`, `go test`, and CI working on a plain machine.
# Regenerate with `make generate`; see ADR-002 §4.

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# ── Node / frontend ──
node_modules/
/frontend/dist/
/frontend/.vite/
*.tsbuildinfo

# ── Helm ──
/charts/**/charts/
/charts/**/*.tgz
/charts/**/Chart.lock

# ── Local environment ──
.env
.env.*
!.env.example
kubeconfig
*.kubeconfig

# ── Editors / OS ──
.DS_Store
.idea/
.vscode/
*.swp

# ── Evaluation scratch (raw results ARE committed; scratch is not) ──
/docs/evaluation/scratch/

# Frontend generated API client — regenerated by `npm run generate:api` from
# contracts/openapi.json. Committed deliberately, same reasoning as the bpf2go bindings: CI and a
# fresh clone must typecheck without running codegen first.
